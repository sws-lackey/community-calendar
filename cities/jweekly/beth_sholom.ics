DTSTART;TZID=America/Los_Angeles:20191205T093000
DTEND;TZID=America/Los_Angeles:20191205T110000
RRULE:FREQ=MONTHLY;COUNT=6;BYDAY=1TH
EXDATE;TZID=America/Los_Angeles:20200402T093000
